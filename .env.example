# WeatherDesk gets all meteorological forecasts, observations, alerts, and radar products
# from public National Weather Service / NOAA data services; no weather API key is used.
# Nominatim is used only for free-text location geocoding (not weather values).
# GitHub Pages repository subpath defaults to /Weather-Forecaster/. To deploy at a root
# custom domain, set VITE_BASE_PATH=/ in the GitHub Actions environment.
# Never place secrets in VITE_* variables: browser-exposed values are not secret.

# Optional AI assistant endpoint. This is a public endpoint URL, not a secret.
# Leave blank to use WeatherDesk's limited local weather helper. A real general-purpose AI model requires the secure backend below.
# For local development with the optional Node backend: http://localhost:8787/api/assistant
VITE_WEATHERDESK_AI_ENDPOINT=

# Server-only variables for `npm run start:ai` (set in the server environment, not VITE_*).
# OPENAI_API_KEY=
# AI_PROVIDER=openai  # openai, anthropic, or ollama (server only)
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# AI_MAX_OUTPUT_TOKENS=850
# AI_DAILY_BUDGET_USD=  # optional; budget enforcement depends on provider usage metadata
# AI_PORT=8787
# AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
